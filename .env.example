# Supabase project settings — API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase renamed "anon key" to "publishable key" — same value, new name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key — full DB access, bypasses RLS entirely.
# NEVER prefix this with NEXT_PUBLIC_. It must only be read on the server.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider: groq (default) or gemini.
AI_PROVIDER=groq

# Primary AI provider. Uses openai/gpt-oss-120b.
GROQ_API_KEY=

# Gemini API key (used when AI_PROVIDER=gemini or as Groq fallback).
LLM_API_KEY=

# WhatsApp Cloud API credentials.
# Note: the business phone number ID is stored per-business in the
# database, not read from an env var here.
WHATSAPP_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Shared secret the Nudges cron endpoint (/api/cron/nudges) checks for in
# its Authorization: Bearer header. Vercel Cron sends whatever's set in
# vercel.json's headers automatically; any other scheduler needs this
# value set manually.
CRON_SECRET=